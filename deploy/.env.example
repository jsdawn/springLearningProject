# deploy 环境密钥配置模板
# 用法：复制本文件为 deploy/.env 并填入真实值（.env 已被 .gitignore 忽略，不进 git）
# compose -f deploy/docker-compose.ghcr.yml 启动时自动读取同目录下的 .env

# MySQL root 密码（mysql 容器初始化与业务服务连接共用）
MYSQL_ROOT_PASSWORD=change-me

# JWT 签名密钥（Base64 编码的 32 字节随机值）
# 生成：python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
JWT_SECRET=change-me-base64-32-bytes
