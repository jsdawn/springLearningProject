{
  "openapi": "3.0.3",
  "info": {
    "title": "user-service API",
    "version": "1.1.0",
    "description": "OpenAPI definition for user-service endpoints."
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "Local user-service"
    }
  ],
  "tags": [
    {
      "name": "Users",
      "description": "User management endpoints"
    }
  ],
  "paths": {
    "/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "List users",
        "operationId": "listUsers",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUserList"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create user",
        "operationId": "createUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreateRequest"
              },
              "example": {
                "username": "alice",
                "nickname": "Alice",
                "phone": "13800000002",
                "email": "alice@example.com",
                "userType": 2,
                "status": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUser"
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get user detail",
        "operationId": "getUserById",
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUser"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Users"
        ],
        "summary": "Update user",
        "operationId": "updateUser",
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdateRequest"
              },
              "example": {
                "username": "alice",
                "nickname": "Alice Updated",
                "phone": "13800000003",
                "email": "alice.updated@example.com",
                "userType": 2,
                "status": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUser"
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}/status": {
      "patch": {
        "tags": [
          "Users"
        ],
        "summary": "Change user status",
        "operationId": "changeUserStatus",
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          },
          {
            "name": "status",
            "in": "query",
            "required": true,
            "description": "1 for enabled, 0 for disabled",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUser"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "UserId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "User ID",
        "schema": {
          "type": "integer",
          "format": "int64"
        },
        "example": 1
      }
    },
    "schemas": {
      "ApiResponseUser": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "ApiResponseUserList": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "username": {
            "type": "string",
            "example": "alice"
          },
          "nickname": {
            "type": "string",
            "example": "Alice"
          },
          "phone": {
            "type": "string",
            "example": "13800000002"
          },
          "email": {
            "type": "string",
            "example": "alice@example.com"
          },
          "userType": {
            "type": "integer",
            "description": "1 for admin, 2 for normal user",
            "example": 2
          },
          "status": {
            "type": "integer",
            "description": "1 for enabled, 0 for disabled",
            "example": 1
          },
          "createTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-12T12:00:00"
          },
          "updateTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-12T12:30:00"
          }
        }
      },
      "UserCreateRequest": {
        "type": "object",
        "required": [
          "username",
          "nickname",
          "userType",
          "status"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "userType": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          },
          "status": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        }
      },
      "UserUpdateRequest": {
        "type": "object",
        "required": [
          "username",
          "nickname",
          "userType",
          "status"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "userType": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          },
          "status": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        }
      }
    }
  }
}
