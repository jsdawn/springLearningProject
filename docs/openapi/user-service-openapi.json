{
  "openapi": "3.0.3",
  "info": {
    "title": "用户服务 API",
    "version": "1.1.0",
    "description": "user-service 接口定义文档。"
  },
  "servers": [
    {
      "url": "http://localhost:8080/api/user",
      "description": "本地网关(用户服务)"
    },
    {
      "url": "http://localhost:8081",
      "description": "本地用户服务"
    }
  ],
  "tags": [
    {
      "name": "用户管理",
      "description": "用户管理相关接口"
    },
    {
      "name": "认证",
      "description": "登录/注册/注销相关接口"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "登录",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "username": "admin",
                "password": "123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseLoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "注册",
        "operationId": "register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "username": "alice",
                "password": "123456",
                "nickname": "Alice",
                "phone": "13800000002",
                "email": "alice@example.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseLong"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "注销",
        "operationId": "logout",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "Bearer Token",
            "schema": {
              "type": "string"
            },
            "example": "Bearer {token}"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": [
          "用户管理"
        ],
        "summary": "查询用户列表（需权限点 users:list）",
        "operationId": "listUsers",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUserList"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "用户管理"
        ],
        "summary": "创建用户",
        "operationId": "createUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreateRequest"
              },
              "example": {
                "username": "alice",
                "nickname": "Alice",
                "phone": "13800000002",
                "email": "alice@example.com",
                "userType": 2,
                "status": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUser"
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": [
          "用户管理"
        ],
        "summary": "查询用户详情（需权限点 users:detail）",
        "operationId": "getUserById",
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUser"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "用户管理"
        ],
        "summary": "更新用户（需权限点 users:update）",
        "operationId": "updateUser",
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdateRequest"
              },
              "example": {
                "username": "alice",
                "nickname": "Alice Updated",
                "phone": "13800000003",
                "email": "alice.updated@example.com",
                "userType": 2,
                "status": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUser"
                }
              }
            }
          }
        }
      }
    },
    "/users/internal/{id}": {
      "get": {
        "tags": [
          "用户管理"
        ],
        "summary": "内部查询用户（服务间调用，不设权限门槛）",
        "description": "仅供 order-service 经 Feign 在下单时校验用户，不经网关、无用户角色上下文。生产环境应叠加内网隔离或内部调用凭证。",
        "operationId": "getUserByIdInternal",
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUser"
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}/status": {
      "patch": {
        "tags": [
          "用户管理"
        ],
        "summary": "修改用户状态",
        "operationId": "changeUserStatus",
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          },
          {
            "name": "status",
            "in": "query",
            "required": true,
            "description": "1 表示启用，0 表示禁用",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUser"
                }
              }
            }
          }
        }
      }
    },
    "/users/page": {
      "get": {
        "tags": [
          "用户管理"
        ],
        "summary": "分页查询用户列表（需权限点 users:page）",
        "operationId": "pageUsers",
        "parameters": [
          {
            "name": "pageNum",
            "in": "query",
            "required": false,
            "description": "页码，默认 1",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "example": 1
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "每页条数，默认 10",
            "schema": {
              "type": "integer",
              "default": 10
            },
            "example": 10
          },
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "模糊搜索关键字（匹配 username/nickname）",
            "schema": {
              "type": "string"
            },
            "example": "alice"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUserPage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "UserId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "用户 ID",
        "schema": {
          "type": "integer",
          "format": "int64"
        },
        "example": 1
      }
    },
    "schemas": {
      "ApiResponseLoginResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/LoginResponse"
          }
        }
      },
      "ApiResponseLong": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "type": "integer",
            "format": "int64",
            "example": 1
          }
        }
      },
      "ApiResponseVoid": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "nullable": true,
            "example": null
          }
        }
      },
      "ApiResponseUser": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "ApiResponseUserList": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          }
        }
      },
      "ApiResponseUserPage": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/UserPage"
          }
        }
      },
      "UserPage": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "总记录数",
            "example": 100
          },
          "pages": {
            "type": "integer",
            "format": "int64",
            "description": "总页数",
            "example": 10
          },
          "current": {
            "type": "integer",
            "description": "当前页码（从 1 开始）",
            "example": 1
          },
          "size": {
            "type": "integer",
            "description": "每页条数",
            "example": 10
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "username": {
            "type": "string",
            "example": "alice"
          },
          "nickname": {
            "type": "string",
            "example": "Alice"
          },
          "phone": {
            "type": "string",
            "example": "13800000002"
          },
          "email": {
            "type": "string",
            "example": "alice@example.com"
          },
          "userType": {
            "type": "integer",
            "description": "1 表示管理员，2 表示普通用户",
            "example": 2
          },
          "status": {
            "type": "integer",
            "description": "1 表示启用，0 表示禁用",
            "example": 1
          },
          "createTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-12T12:00:00"
          },
          "updateTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-12T12:30:00"
          }
        }
      },
      "UserCreateRequest": {
        "type": "object",
        "required": [
          "username",
          "nickname",
          "userType",
          "status"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "userType": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          },
          "status": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        }
      },
      "UserUpdateRequest": {
        "type": "object",
        "required": [
          "username",
          "nickname",
          "userType",
          "status"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "userType": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          },
          "status": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "admin"
          },
          "password": {
            "type": "string",
            "example": "123456"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "username",
          "password",
          "nickname"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "alice"
          },
          "password": {
            "type": "string",
            "example": "123456"
          },
          "nickname": {
            "type": "string",
            "example": "Alice"
          },
          "phone": {
            "type": "string",
            "example": "13800000002"
          },
          "email": {
            "type": "string",
            "example": "alice@example.com"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expireSeconds": {
            "type": "integer",
            "format": "int64",
            "example": 3600
          }
        }
      }
    }
  }
}
