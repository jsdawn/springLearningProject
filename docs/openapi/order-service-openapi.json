{
  "openapi": "3.0.3",
  "info": {
    "title": "订单服务 API",
    "version": "1.0.0",
    "description": "order-service 接口定义文档。"
  },
  "servers": [
    {
      "url": "http://localhost:8080/api/order",
      "description": "本地网关(订单服务)"
    },
    {
      "url": "http://localhost:8083",
      "description": "本地订单服务"
    }
  ],
  "tags": [
    {
      "name": "订单管理",
      "description": "订单管理相关接口"
    }
  ],
  "paths": {
    "/orders": {
      "get": {
        "tags": [
          "订单管理"
        ],
        "summary": "查询订单列表",
        "operationId": "listOrders",
        "parameters": [
          {
            "name": "orderNo",
            "in": "query",
            "required": false,
            "description": "按订单号模糊查询",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "description": "按用户 ID 查询",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrderList"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "订单管理"
        ],
        "summary": "创建订单",
        "operationId": "createOrder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderCreateRequest"
              },
              "example": {
                "userId": 1,
                "items": [
                  {
                    "productId": 1,
                    "quantity": 1
                  },
                  {
                    "productId": 2,
                    "quantity": 2
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrder"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "tags": [
          "订单管理"
        ],
        "summary": "查询订单详情",
        "operationId": "getOrderById",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrder"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{id}/cancel": {
      "patch": {
        "tags": [
          "订单管理"
        ],
        "summary": "取消订单",
        "operationId": "cancelOrder",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrder"
                }
              }
            }
          }
        }
      }
    },
    "/orders/page": {
      "get": {
        "tags": [
          "订单管理"
        ],
        "summary": "分页查询订单列表",
        "operationId": "pageOrders",
        "parameters": [
          {
            "name": "pageNum",
            "in": "query",
            "required": false,
            "description": "页码，默认 1",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "example": 1
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "每页条数，默认 10",
            "schema": {
              "type": "integer",
              "default": 10
            },
            "example": 10
          },
          {
            "name": "orderNo",
            "in": "query",
            "required": false,
            "description": "按订单号模糊查询",
            "schema": {
              "type": "string"
            },
            "example": "ORD2026"
          },
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "description": "按用户 ID 查询",
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrderPage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "OrderId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "订单 ID",
        "schema": {
          "type": "integer",
          "format": "int64"
        },
        "example": 1
      }
    },
    "schemas": {
      "ApiResponseOrder": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/Order"
          }
        }
      },
      "ApiResponseOrderList": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          }
        }
      },
      "ApiResponseOrderPage": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/OrderPage"
          }
        }
      },
      "OrderPage": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "总记录数",
            "example": 25
          },
          "pages": {
            "type": "integer",
            "format": "int64",
            "description": "总页数",
            "example": 3
          },
          "current": {
            "type": "integer",
            "description": "当前页码（从 1 开始）",
            "example": 1
          },
          "size": {
            "type": "integer",
            "description": "每页条数",
            "example": 10
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "orderNo": {
            "type": "string",
            "example": "ORD20260712143000123"
          },
          "userId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "totalAmount": {
            "type": "number",
            "format": "double",
            "example": 397.0
          },
          "status": {
            "type": "integer",
            "description": "1 表示已创建，2 表示已取消",
            "example": 1
          },
          "createTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-12T14:30:00"
          },
          "updateTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-12T14:31:00"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          }
        }
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "orderId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "productId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "productName": {
            "type": "string",
            "example": "Keyboard"
          },
          "productPrice": {
            "type": "number",
            "format": "double",
            "example": 199.0
          },
          "quantity": {
            "type": "integer",
            "example": 2
          },
          "amount": {
            "type": "number",
            "format": "double",
            "example": 398.0
          }
        }
      },
      "OrderCreateRequest": {
        "type": "object",
        "required": [
          "userId",
          "items"
        ],
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/OrderCreateItem"
            }
          }
        }
      },
      "OrderCreateItem": {
        "type": "object",
        "required": [
          "productId",
          "quantity"
        ],
        "properties": {
          "productId": {
            "type": "integer",
            "format": "int64"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
