{
  "openapi": "3.0.3",
  "info": {
    "title": "订单服务 API",
    "version": "1.0.0",
    "description": "order-service 接口定义文档。"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "本地网关"
    }
  ],
  "tags": [
    {
      "name": "订单管理",
      "description": "订单管理相关接口"
    }
  ],
  "paths": {
    "/api/order/orders": {
      "get": {
        "tags": [
          "订单管理"
        ],
        "summary": "查询订单列表",
        "operationId": "listOrders",
        "parameters": [
          {
            "name": "orderNo",
            "in": "query",
            "required": false,
            "description": "按订单号模糊查询",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "description": "按用户 ID 查询",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrderList"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "订单管理"
        ],
        "summary": "创建订单",
        "operationId": "createOrder",
        "description": "需先调用 GET /orders/idempotent-token 领取一次性幂等令牌，并通过 X-Idempotent-Token 请求头携带。令牌消费成功即作废（5 分钟过期），同一令牌重复提交返回 409，订单不重复创建、库存不二次扣减。",
        "parameters": [
          {
            "name": "X-Idempotent-Token",
            "in": "header",
            "required": true,
            "description": "下单幂等令牌，由 GET /orders/idempotent-token 下发，一次性使用，5 分钟内有效。缺失返回 400，已使用/已过期/伪造返回 409",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "3f8a2c1e-9d4b-4e6a-8f2b-7c5d1e0a9b3c"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderCreateRequest"
              },
              "example": {
                "userId": 1,
                "items": [
                  {
                    "productId": 1,
                    "quantity": 1
                  },
                  {
                    "productId": 2,
                    "quantity": 2
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrder"
                }
              }
            }
          },
          "400": {
            "description": "参数错误（含缺少幂等令牌：未携带 X-Idempotent-Token 请求头）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseError"
                }
              }
            }
          },
          "409": {
            "description": "重复提交：幂等令牌已使用、已过期或不存在，订单未创建、库存未扣减，需重新领号后再提交",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseError"
                },
                "example": {
                  "code": 409,
                  "message": "请勿重复提交（令牌已使用或已过期，请重新获取）",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/order/orders/idempotent-token": {
      "get": {
        "tags": [
          "订单管理"
        ],
        "summary": "获取下单幂等令牌",
        "operationId": "issueIdempotentToken",
        "description": "下发一次性幂等令牌（UUID），用于创建订单时防重复提交。需登录后调用。令牌 5 分钟内有效且只能消费一次，建议在进入下单页或提交前领取。",
        "responses": {
          "200": {
            "description": "成功，返回令牌本身",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseIdempotentToken"
                }
              }
            }
          }
        }
      }
    },
    "/api/order/orders/{id}": {
      "get": {
        "tags": [
          "订单管理"
        ],
        "summary": "查询订单详情",
        "operationId": "getOrderById",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrder"
                }
              }
            }
          }
        }
      }
    },
    "/api/order/orders/{id}/cancel": {
      "patch": {
        "tags": [
          "订单管理"
        ],
        "summary": "取消订单",
        "operationId": "cancelOrder",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrder"
                }
              }
            }
          }
        }
      }
    },
    "/api/order/orders/page": {
      "get": {
        "tags": [
          "订单管理"
        ],
        "summary": "分页查询订单列表",
        "operationId": "pageOrders",
        "description": "LIMIT-OFFSET 分页。偏移量较小时直接 LIMIT；偏移量达到阈值（1000）后服务端自动切换为延迟关联（子查询定位 id）优化，调用方无感知。深分页建议改用 GET /orders/page/cursor",
        "parameters": [
          {
            "name": "pageNum",
            "in": "query",
            "required": false,
            "description": "页码，默认 1",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "example": 1
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "每页条数，默认 10",
            "schema": {
              "type": "integer",
              "default": 10
            },
            "example": 10
          },
          {
            "name": "orderNo",
            "in": "query",
            "required": false,
            "description": "按订单号模糊查询",
            "schema": {
              "type": "string"
            },
            "example": "ORD2026"
          },
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "description": "按用户 ID 查询",
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "按订单状态筛选：1 已创建（待支付）、2 已取消、3 超时自动关闭。不传则不限状态",
            "schema": {
              "type": "integer",
              "enum": [
                1,
                2,
                3
              ]
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrderPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/order/orders/page/cursor": {
      "get": {
        "tags": [
          "订单管理"
        ],
        "summary": "游标分页查询订单列表",
        "operationId": "pageOrdersByCursor",
        "description": "以上一页最后一条记录的 id（lastId）续拉下一页，翻页成本恒定，适合「加载更多」式交互。不支持跳页、不返回总数；响应中的 nextCursor 直接作为下一次请求的 lastId 传入，hasMore=false 表示已到末尾",
        "parameters": [
          {
            "name": "lastId",
            "in": "query",
            "required": false,
            "description": "游标：上一页最后一条记录的 id，默认 0 表示从第一页开始",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0,
              "minimum": 0
            },
            "example": 9980
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "每页条数，默认 10，最大 100",
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 100
            },
            "example": 10
          },
          {
            "name": "orderNo",
            "in": "query",
            "required": false,
            "description": "按订单号模糊查询",
            "schema": {
              "type": "string"
            },
            "example": "ORDSEED"
          },
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "description": "按用户 ID 查询",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "example": 1
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "按订单状态筛选：1 已创建（待支付）、2 已取消、3 超时自动关闭。不传则不限状态",
            "schema": {
              "type": "integer",
              "enum": [
                1,
                2,
                3
              ]
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrderCursorPage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "OrderId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "订单 ID",
        "schema": {
          "type": "integer",
          "format": "int64"
        },
        "example": 1
      }
    },
    "schemas": {
      "ApiResponseIdempotentToken": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "Idempotent token issued"
          },
          "data": {
            "type": "string",
            "description": "一次性幂等令牌（UUID），提交下单时放入 X-Idempotent-Token 请求头，5 分钟有效",
            "example": "3f8a2c1e-9d4b-4e6a-8f2b-7c5d1e0a9b3c"
          }
        }
      },
      "ApiResponseError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "业务错误码，与 HTTP 状态码一致",
            "example": 409
          },
          "message": {
            "type": "string",
            "example": "请勿重复提交（令牌已使用或已过期，请重新获取）"
          },
          "data": {
            "type": "object",
            "nullable": true,
            "description": "错误时为 null"
          }
        }
      },
      "ApiResponseOrder": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/Order"
          }
        }
      },
      "ApiResponseOrderList": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          }
        }
      },
      "ApiResponseOrderPage": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/OrderPage"
          }
        }
      },
      "OrderPage": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "总记录数",
            "example": 25
          },
          "pages": {
            "type": "integer",
            "format": "int64",
            "description": "总页数",
            "example": 3
          },
          "current": {
            "type": "integer",
            "description": "当前页码（从 1 开始）",
            "example": 1
          },
          "size": {
            "type": "integer",
            "description": "每页条数",
            "example": 10
          }
        }
      },
      "ApiResponseOrderCursorPage": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/OrderCursorPage"
          }
        }
      },
      "OrderCursorPage": {
        "type": "object",
        "description": "游标分页结果：不返回 total/pages，用 nextCursor + hasMore 续拉",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "nextCursor": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "下一页游标（本页最后一条记录的 id）；null 表示没有更多数据",
            "example": 9999
          },
          "hasMore": {
            "type": "boolean",
            "description": "是否还有下一页",
            "example": true
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "orderNo": {
            "type": "string",
            "example": "ORD20260712143000123"
          },
          "userId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "totalAmount": {
            "type": "number",
            "format": "double",
            "example": 397.0
          },
          "status": {
            "type": "integer",
            "description": "1 表示已创建（待支付），2 表示已取消，3 表示超时自动关闭",
            "example": 1
          },
          "createTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-12T14:30:00"
          },
          "updateTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-12T14:31:00"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          }
        }
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "orderId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "productId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "productName": {
            "type": "string",
            "example": "Keyboard"
          },
          "productPrice": {
            "type": "number",
            "format": "double",
            "example": 199.0
          },
          "quantity": {
            "type": "integer",
            "example": 2
          },
          "amount": {
            "type": "number",
            "format": "double",
            "example": 398.0
          }
        }
      },
      "OrderCreateRequest": {
        "type": "object",
        "required": [
          "userId",
          "items"
        ],
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/OrderCreateItem"
            }
          }
        }
      },
      "OrderCreateItem": {
        "type": "object",
        "required": [
          "productId",
          "quantity"
        ],
        "properties": {
          "productId": {
            "type": "integer",
            "format": "int64"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}