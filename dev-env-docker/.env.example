COMPOSE_PROJECT_NAME=spring-env

MYSQL_VERSION=8.0
NACOS_VERSION=2.5.3
REDIS_VERSION=5.0.14
SENTINEL_VERSION=1.8.6
# -management 标签镜像自带 Web 管理台（15672），便于观察死信延时队列
RABBITMQ_VERSION=3.12-management

MYSQL_PORT=3306
NACOS_PORT=8848
REDIS_PORT=6379
SENTINEL_PORT=8858
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# RabbitMQ 默认账号（仅首次初始化生效），与 order-service 的 application.yml 保持一致
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

MYSQL_ROOT_PASSWORD=
DB_NAME=mall_db
DB_USERNAME=biz_user
DB_PASSWORD=
