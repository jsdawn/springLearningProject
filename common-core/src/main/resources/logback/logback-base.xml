<?xml version="1.0" encoding="UTF-8"?>
<!--
  公共日志配置片段，放在 common-core jar 内，各 Servlet 服务（order/user/product）的
  logback-spring.xml 通过 <include resource="logback/logback-base.xml"/> 引入。
  网关（WebFlux）不依赖 common-core，维护自己独立的 logback-spring.xml，格式保持一致。

  约定：MDC key 为 traceId / userId，由 common-core 的 TraceIdFilter 写入。
-->
<included>
    <!-- 从 spring.application.name 取应用名，进日志前缀与文件名 -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="app"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [${APP_NAME}] [%thread] [traceId=%X{traceId:-N/A}] [userId=%X{userId:-N/A}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 文件输出：本地联调可 grep，也便于跨服务比对 traceId；按天滚动保留 7 天 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/${APP_NAME}.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</included>
