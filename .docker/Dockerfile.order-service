# syntax=docker/dockerfile:1
# 多阶段构建：构建层用 Maven(JDK8) 编译打包，运行层只用 JRE 8，镜像不携带构建工具
# 构建上下文必须是仓库根目录：docker build -f .docker/Dockerfile.order-service -t order-service .

FROM maven:3.8-openjdk-8 AS build
WORKDIR /build
# 先拷 pom 预拉依赖，利用层缓存：源码变动不触发全量重新下载
COPY pom.xml .
COPY common-auth/pom.xml common-auth/pom.xml
COPY common-core/pom.xml common-core/pom.xml
COPY user-service/pom.xml user-service/pom.xml
COPY order-service/pom.xml order-service/pom.xml
COPY product-service/pom.xml product-service/pom.xml
COPY gateway-service/pom.xml gateway-service/pom.xml
RUN mvn -B -q dependency:go-offline || true
# 再拷全量源码，只构建目标模块及其依赖链
COPY . .
RUN mvn -B -pl order-service -am clean package -DskipTests
# 用 layertools 把 fat jar 拆成四个独立层（Boot 2.3+ 原生支持，无需额外依赖）：
# dependencies(依赖,~95%体积,基本不变) / spring-boot-loader / snapshot-dependencies / application(业务代码,每次变)
# 拆层后改代码只重传 application 层，部署拉取量从 ~85MB 降到 ~MB 级
RUN mkdir -p /build/order-service/target/extracted \
    && cd /build/order-service/target/extracted \
    && java -Djarmode=layertools -jar ../*.jar extract

FROM eclipse-temurin:8-jre
WORKDIR /app
ENV TZ=Asia/Shanghai \
    JAVA_OPTS="-Dfile.encoding=UTF-8 -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0"
# 按变化频率从低到高分层 COPY：依赖层内容不变即命中远端缓存，只有 application 层每次重传
COPY --from=build /build/order-service/target/extracted/dependencies/ ./
COPY --from=build /build/order-service/target/extracted/spring-boot-loader/ ./
COPY --from=build /build/order-service/target/extracted/snapshot-dependencies/ ./
COPY --from=build /build/order-service/target/extracted/application/ ./
EXPOSE 8083
# 分层 jar 的标准启动方式：JarLauncher 按层加载，等价于 java -jar
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS org.springframework.boot.loader.JarLauncher"]
