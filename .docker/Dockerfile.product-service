# syntax=docker/dockerfile:1
# 构建上下文必须是仓库根目录：docker build -f .docker/Dockerfile.product-service -t product-service .

FROM maven:3.8-openjdk-8 AS build
WORKDIR /build
COPY pom.xml .
COPY common-auth/pom.xml common-auth/pom.xml
COPY common-core/pom.xml common-core/pom.xml
COPY user-service/pom.xml user-service/pom.xml
COPY order-service/pom.xml order-service/pom.xml
COPY product-service/pom.xml product-service/pom.xml
COPY gateway-service/pom.xml gateway-service/pom.xml
RUN mvn -B -q dependency:go-offline || true
COPY . .
RUN mvn -B -pl product-service -am clean package -DskipTests
# layertools 拆层：依赖层(不变,~95%体积)与应用层(每次变)分离，改代码只重传应用层
RUN mkdir -p /build/product-service/target/extracted \
    && cd /build/product-service/target/extracted \
    && java -Djarmode=layertools -jar ../*.jar extract

FROM eclipse-temurin:8-jre
WORKDIR /app
ENV TZ=Asia/Shanghai \
    JAVA_OPTS="-Dfile.encoding=UTF-8 -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0"
COPY --from=build /build/product-service/target/extracted/dependencies/ ./
COPY --from=build /build/product-service/target/extracted/spring-boot-loader/ ./
COPY --from=build /build/product-service/target/extracted/snapshot-dependencies/ ./
COPY --from=build /build/product-service/target/extracted/application/ ./
EXPOSE 8082
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS org.springframework.boot.loader.JarLauncher"]
